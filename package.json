{
  "name": "job-match-api",
  "version": "1.0.0",
  "private": true,
  "description": "Skeleton API for job matching",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate.js",
    "test": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobmatch jest",
    "test:scoring": "jest scoringService.test.ts",
    "test:api": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobmatch jest api.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
